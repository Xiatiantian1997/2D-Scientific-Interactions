{
  "version": "3.0",
  "goal": "等体积两区随机交换可以双向同时发生；净迁移由浓度差产生，平衡时双向交换仍存在。",
  "model": {
    "assumptions": "两区充分混合、等体积、封闭总量100；对称一阶交换，左量=50+30exp(-2t)，右量=100-左量；箭头表示期望交换率而非确定粒子轨迹。",
    "evidence": "对称两区一阶质量守恒方程的解析教学模型，不是材料参数预测。"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "初始浓度80:20"
    },
    {
      "id": "changed",
      "meaning": "随时间趋于50:50"
    }
  ],
  "encodings": [
    {
      "scope": "diffusion-exchange",
      "channel": "fill-or-stroke",
      "token": "series-1",
      "role": "identity",
      "meaning": "同一种扩散粒子及交换率"
    },
    {
      "scope": "diffusion-exchange",
      "channel": "opacity-or-dash",
      "token": "ghost",
      "role": "observer",
      "meaning": "初始浓度虚影"
    }
  ],
  "actions": [
    {
      "id": "adjust",
      "kind": "time",
      "changes": [
        "time"
      ],
      "fixed": [
        "total_amount",
        "exchange_coefficient",
        "volumes"
      ],
      "feedback": "横拖图形或时间条回看；轻点播放/暂停，结束回起点停住。"
    },
    {
      "id": "compare",
      "kind": "compare",
      "changes": [
        "time"
      ],
      "fixed": [
        "scale",
        "layout"
      ],
      "feedback": "短按对应控件区域实际空白恢复默认值；文字、读数、拖动、滚动、取消和多指不触发。"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "time"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "changed",
    "action": "compare",
    "fixed": [
      "scale",
      "layout"
    ],
    "placement": "原位固定基准；对应控件区域空白局部复位"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "默认静止；点击时间条或图形播放/暂停；结束回起点停住；失焦或后台暂停。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
