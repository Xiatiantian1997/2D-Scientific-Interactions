{
  "version": "3.0",
  "goal": "局部随机运动与整体分布变化来自同一组粒子",
  "model": {
    "assumptions": "160个粒子作等概率一维随机游走，反射边界；纵坐标仅分散绘制，不是第二运动维度。固定随机种子；步间直线插值是显示过渡，不是分子轨迹。",
    "evidence": "固定种子的对称随机游走，反射边界；非分子动力学。"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "初始聚集分布与中心观察窗"
    },
    {
      "id": "changed",
      "meaning": "随机游走后的分布或移动后的观察窗"
    }
  ],
  "encodings": [
    {
      "scope": "diffusion-lens",
      "channel": "color",
      "token": "series-1",
      "role": "identity",
      "meaning": "同一种粒子，颜色不表示异常"
    },
    {
      "scope": "diffusion-lens",
      "channel": "opacity",
      "token": "ghost",
      "role": "observer",
      "meaning": "初始聚集范围，不是新增粒子"
    }
  ],
  "actions": [
    {
      "id": "change",
      "kind": "time",
      "changes": [
        "time"
      ],
      "fixed": [
        "particle_identity",
        "particle_count"
      ],
      "feedback": "同一组对象连续更新，暂停或直接操作会中断旧动画"
    },
    {
      "id": "baseline-compare",
      "kind": "compare",
      "changes": [
        "comparison_visibility_or_time"
      ],
      "fixed": [
        "particle_identity",
        "particle_count"
      ],
      "feedback": "恢复初始分布；浅色带始终标出初始聚集范围"
    },
    {
      "id": "lower-blank-reset",
      "kind": "observe",
      "changes": [
        "time_and_window"
      ],
      "fixed": [
        "particle_identity_and_count"
      ],
      "feedback": "下方操作区空白短按或根区域R键复位；恢复t=0与中心观察窗。控件、滚动、拖动、长按、多指和取消均不触发；轻暗反馈。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "changed",
    "action": "baseline-compare",
    "fixed": [
      "particle_identity",
      "particle_count"
    ],
    "placement": "原位浅色初始范围与同批粒子回看"
  },
  "validation": "../docs/validation.md"
}
