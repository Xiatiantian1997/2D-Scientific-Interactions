{
  "version": "3.0",
  "goal": "局部随机运动与整体分布变化来自同一组粒子",
  "model": {
    "assumptions": "160个粒子作等概率一维随机游走，反射边界；纵坐标仅分散绘制，不是第二运动维度。固定随机种子；步间直线插值是显示过渡，不是分子轨迹。",
    "evidence": "固定种子的对称随机游走，反射边界；非分子动力学。"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "初始聚集分布与中心观察窗"
    },
    {
      "id": "changed",
      "meaning": "随机游走后的分布或移动后的观察窗"
    }
  ],
  "encodings": [
    {
      "scope": "diffusion-lens",
      "channel": "color",
      "token": "series-1",
      "role": "identity",
      "meaning": "同一种粒子，颜色不表示异常"
    },
    {
      "scope": "diffusion-lens",
      "channel": "opacity",
      "token": "ghost",
      "role": "observer",
      "meaning": "初始聚集范围，不是新增粒子"
    }
  ],
  "actions": [
    {
      "id": "change",
      "kind": "time",
      "changes": [
        "time"
      ],
      "fixed": [
        "particle_identity",
        "particle_count"
      ],
      "feedback": "同一批粒子连续更新；时间与观察位置独立控制，拖动不追加点击。"
    },
    {
      "id": "baseline-compare",
      "kind": "compare",
      "changes": [
        "comparison_visibility_or_time"
      ],
      "fixed": [
        "particle_identity",
        "particle_count"
      ],
      "feedback": "恢复初始分布；浅色带始终标出初始聚集范围"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "time",
        "lens"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "changed",
    "action": "baseline-compare",
    "fixed": [
      "particle_identity",
      "particle_count"
    ],
    "placement": "原位浅色初始范围与同批粒子回看"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "默认静止；点击时间条或图形播放/暂停；结束回起点停住；失焦或后台暂停。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
