      "kind": "time",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "图中横拖或进度条回看；拖动暂停"
    },
    {
      "id": "play",
      "kind": "time",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "连续推进一次，到终点停止"
    },
    {
      "id": "lower-blank-reset",
      "kind": "observe",
      "changes": [
        "progress"
      ],
      "fixed": [
        "pulse_type"
