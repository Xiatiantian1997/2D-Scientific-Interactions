{
  "version": "3.0",
  "goal": "看懂两列脉冲相遇时位移相加，相消后仍继续传播。",
  "model": {
    "assumptions": "线性一维无色散波动方程的两个高斯行波；归一化位移；不是量子波函数或能量曲线。",
    "evidence": "解析模型 u=f(x-ct)+g(x+ct)，满足线性波动方程；相消是瞬时位移抵消。"
  },
  "states": [
    {
      "id": "same",
      "meaning": "基准情景"
    },
    {
      "id": "opposite",
      "meaning": "对照情景"
    },
    {
      "id": "playing",
      "meaning": "连续推进，非循环"
    },
    {
      "id": "paused",
      "meaning": "停留并回看"
    }
  ],
  "encodings": [
    {
      "scope": "wave-overlap",
      "channel": "mark",
      "token": "solid",
      "role": "quantity",
      "meaning": "总位移"
    },
    {
      "scope": "wave-overlap",
      "channel": "mark",
      "token": "dash",
      "role": "quantity",
      "meaning": "右行分量"
    },
    {
      "scope": "wave-overlap",
      "channel": "mark",
      "token": "dot",
      "role": "quantity",
      "meaning": "左行分量"
    }
  ],
  "actions": [
    {
      "id": "compare",
      "kind": "compare",
      "changes": [
        "scenario"
      ],
      "fixed": [
        "progress",
        "view",
        "scale"
      ],
      "feedback": "原位切换情景，暂停播放，保留进度"
    },
    {
      "id": "scrub",
      "kind": "time",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "图中横拖或进度条回看；拖动暂停"
    },
    {
      "id": "play",
      "kind": "time",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "连续推进一次，到终点停止"
    },
    {
      "id": "lower-blank-reset",
      "kind": "observe",
      "changes": [
        "progress"
      ],
      "fixed": [
        "pulse_type"
      ],
      "feedback": "下方操作区空白短按或根区域R键复位；进度恢复0，脉冲类型保持不变。控件、滚动、拖动、长按、多指和取消均不触发；轻暗反馈。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "same",
    "target": "opposite",
    "action": "compare",
    "fixed": [
      "progress",
      "view",
      "scale"
    ],
    "placement": "图下操作区情景按钮"
  },
  "validation": "../docs/validation.md"
}
