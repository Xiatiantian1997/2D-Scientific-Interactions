{
  "version": "3.0",
  "goal": "看懂两列脉冲相遇时位移相加，相消后仍继续传播。",
  "model": {
    "assumptions": "线性一维无色散波动方程的两个高斯行波；归一化位移；不是量子波函数或能量曲线。",
    "evidence": "解析模型 u=f(x-ct)+g(x+ct)，满足线性波动方程；相消是瞬时位移抵消。"
  },
  "states": [
    {
      "id": "same",
      "meaning": "基准情景"
    },
    {
      "id": "opposite",
      "meaning": "对照情景"
    },
    {
      "id": "playing",
      "meaning": "连续推进，非循环"
    },
    {
      "id": "paused",
      "meaning": "停留并回看"
    }
  ],
  "encodings": [
    {
      "scope": "wave-overlap",
      "channel": "mark",
      "token": "solid",
      "role": "quantity",
      "meaning": "总位移"
    },
    {
      "scope": "wave-overlap",
      "channel": "mark",
      "token": "dash",
      "role": "quantity",
      "meaning": "右行分量"
    },
    {
      "scope": "wave-overlap",
      "channel": "mark",
      "token": "dot",
      "role": "quantity",
      "meaning": "左行分量"
    }
  ],
  "actions": [
    {
      "id": "compare",
      "kind": "compare",
      "changes": [
        "scenario"
      ],
      "fixed": [
        "progress",
        "view",
        "scale"
      ],
      "feedback": "单按钮切换情景，保持进度、尺度和播放状态。"
    },
    {
      "id": "scrub",
      "kind": "time",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "横拖图形或进度条回看；拖动临时暂停，释放恢复拖动前的播放状态。"
    },
    {
      "id": "play",
      "kind": "time",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "点击图形或对应进度控件播放/暂停；到终点回起点停住，保留其他参数。"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "mode",
        "time"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "same",
    "target": "opposite",
    "action": "compare",
    "fixed": [
      "progress",
      "view",
      "scale"
    ],
    "placement": "图下操作区情景按钮"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "默认静止；点击时间条或图形播放/暂停；结束回起点停住；失焦或后台暂停。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
