      "meaning": "同批第1项样本"
    },
    {
      "id": "accumulating",
      "meaning": "accumulating"
    },
    {
      "id": "paused",
      "meaning": "paused"
    },
    {
      "id": "complete",
      "meaning": "complete"
    },
    {
