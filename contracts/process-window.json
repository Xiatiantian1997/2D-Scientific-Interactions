{
  "version": "3.0",
  "goal": "一组参数必须同时满足两项要求；两个合格区的交集才是候选工艺窗口。",
  "model": {
    "assumptions": "教学响应模型：相对厚度h=1+.3x+.2y；不均匀度u=.02+.03(x-y)^2；-1≤x,y≤1为归一化温度和流量偏移。要求.9≤h≤1.1，u≤.05；模型与门限均为示意，不可用作配方。",
    "evidence": "Minitab叠加等高线说明与示例图：https://support.minitab.com/en-us/minitab/help-and-how-to/statistical-modeling/using-fitted-models/supporting-topics/graphs/what-is-an-overlaid-contour-plot/"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "中心基准位置"
    },
    {
      "id": "adjusted",
      "meaning": "移动后的观察位置或参数组合"
    }
  ],
  "encodings": [
    {
      "scope": "process-window",
      "channel": "visual-token",
      "token": "series-1",
      "role": "state",
      "meaning": "同时合格区域"
    },
    {
      "scope": "process-window",
      "channel": "visual-token",
      "token": "series-2",
      "role": "relation",
      "meaning": "厚度要求边界"
    },
    {
      "scope": "process-window",
      "channel": "visual-token",
      "token": "series-3",
      "role": "relation",
      "meaning": "不均匀度要求边界"
    },
    {
      "scope": "process-window",
      "channel": "visual-token",
      "token": "point",
      "role": "observer",
      "meaning": "当前参数组合"
    }
  ],
  "actions": [
    {
      "id": "move",
      "kind": "model",
      "changes": [
        "temperature_offset",
        "flow_offset"
      ],
      "fixed": [
        "response_models",
        "acceptance_limits"
      ],
      "feedback": "拖动图中探针或参数点，关联读数更新；下方滑条支持单轴和键盘操作。"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "x",
        "y"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "adjusted",
    "action": "local-reset",
    "fixed": [
      "response_models",
      "acceptance_limits"
    ],
    "placement": "原位固定基准；对应控件区域空白局部复位"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "本例无时间播放；图内操作改变参数或观察位置，不附加播放功能。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
