{
  "version": "3.0",
  "goal": "看懂口部优先生长怎样导致封口留空，与相同顶部厚度的等厚覆盖比较。",
  "model": {
    "assumptions": "二维几何构造，非输运求解；口部宽度固定单位1，壁厚按指数深度衰减，封口后内部停止生长；近似等厚为理想参考，非无缝填充预测。",
    "evidence": "Girolami & Abelson et al., JVST A 38 030802 (2020), doi:10.1116/6.0000035；定性依据为深沟槽供料耗尽和覆盖性，指数形貌为自行构造。"
  },
  "states": [
    {
      "id": "uniform",
      "meaning": "基准情景"
    },
    {
      "id": "depleted",
      "meaning": "对照情景"
    },
    {
      "id": "playing",
      "meaning": "连续推进，非循环"
    },
    {
      "id": "paused",
      "meaning": "停留并回看"
    }
  ],
  "encodings": [
    {
      "scope": "trench-closure",
      "channel": "mark",
      "token": "film",
      "role": "identity",
      "meaning": "新增薄膜"
    },
    {
      "scope": "trench-closure",
      "channel": "mark",
      "token": "substrate",
      "role": "identity",
      "meaning": "原有基底"
    },
    {
      "scope": "trench-closure",
      "channel": "mark",
      "token": "dashed",
      "role": "observer",
      "meaning": "沉积前界面"
    }
  ],
  "actions": [
    {
      "id": "compare",
      "kind": "compare",
      "changes": [
        "scenario"
      ],
      "fixed": [
        "progress",
        "view",
        "scale"
      ],
      "feedback": "单按钮切换情景，保持进度、尺度和播放状态。"
    },
    {
      "id": "scrub",
      "kind": "construct",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "横拖图形或进度条回看；拖动临时暂停，释放恢复拖动前的播放状态。"
    },
    {
      "id": "play",
      "kind": "construct",
      "changes": [
        "progress"
      ],
      "fixed": [
        "scenario",
        "view"
      ],
      "feedback": "点击图形或对应进度控件播放/暂停；到终点回起点停住，保留其他参数。"
    },
    {
      "id": "aspect",
      "kind": "model",
      "changes": [
        "aspect_ratio",
        "width"
      ],
      "fixed": [
        "depth",
        "relative_top_thickness",
        "scenario"
      ],
      "feedback": "改变真实绘制宽度，保持深度；不是缩放镜头"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "mode",
        "time",
        "aspect"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "uniform",
    "target": "depleted",
    "action": "compare",
    "fixed": [
      "progress",
      "view",
      "scale"
    ],
    "placement": "图下操作区情景按钮"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "默认静止；点击时间条或图形播放/暂停；结束回起点停住；失焦或后台暂停。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
