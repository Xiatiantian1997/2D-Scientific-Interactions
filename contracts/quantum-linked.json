{
  "version": "3.0",
  "goal": "同一个势阱定态的概率密度和能级是同一模型的不同表示，不能独立调节。",
  "model": {
    "assumptions": "一维无限深势阱，0<x<L，固定质量与宽度，选n=1..4。 q=x/L，rho*L=2sin²(nπq)，E/E1=n²；概率密度静止，不是粒子运动轨迹。 切换n是选择不同定态的比较，非模拟跃迁过程；能级图横向线长不表示空间范围。",
    "evidence": "https://openstax.org/books/university-physics-volume-3/pages/7-4-the-quantum-particle-in-a-box"
  },
  "states": [
    {
      "id": "initial",
      "meaning": "n=1基态"
    },
    {
      "id": "n2",
      "meaning": "n2"
    },
    {
      "id": "n3",
      "meaning": "n3"
    },
    {
      "id": "n4",
      "meaning": "n4"
    }
  ],
  "encodings": [
    {
      "scope": "lesson",
      "channel": "curve",
      "token": "series-1",
      "role": "quantity",
      "meaning": "所选定态的位置概率密度"
    },
    {
      "scope": "lesson",
      "channel": "level",
      "token": "series-1",
      "role": "attention",
      "meaning": "同一个所选定态的能量"
    },
    {
      "scope": "lesson",
      "channel": "other-level",
      "token": "neutral",
      "role": "quantity",
      "meaning": "其余允许能级"
    }
  ],
  "actions": [
    {
      "id": "select",
      "kind": "model",
      "changes": [
        "n",
        "density",
        "energy"
      ],
      "fixed": [
        "L",
        "mass",
        "axes"
      ],
      "feedback": "两图与读数同步切换到合法定态"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "state"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "initial",
    "target": "n2",
    "action": "local-reset",
    "fixed": [
      "model conditions",
      "axes"
    ],
    "placement": "原位固定基准；对应控件区域空白局部复位"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "本例无时间播放；图内操作改变参数或观察位置，不附加播放功能。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
