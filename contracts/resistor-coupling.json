{
  "version": "3.0",
  "goal": "同一个电阻变化在恒压与恒流下产生相反的发热趋势。",
  "model": {
    "assumptions": "理想欧姆电阻和无限顺应电源，温度不反馈到R；恒压6V或恒流2A；R=1.5至12Ω；I=U/R，P=UI，固定基准R=3Ω。",
    "evidence": "欧姆定律I=U/R及焦耳定律P=UI。"
  },
  "states": [
    {
      "id": "voltage",
      "meaning": "voltage"
    },
    {
      "id": "current",
      "meaning": "current"
    }
  ],
  "encodings": [
    {
      "scope": "resistor-coupling",
      "channel": "mark",
      "token": "current",
      "role": "quantity",
      "meaning": "电流及电流条"
    },
    {
      "scope": "resistor-coupling",
      "channel": "mark",
      "token": "power",
      "role": "quantity",
      "meaning": "功率及功率条"
    },
    {
      "scope": "resistor-coupling",
      "channel": "mark",
      "token": "ghost",
      "role": "observer",
      "meaning": "当前供电模式下R=3Ω的基准"
    }
  ],
  "actions": [
    {
      "id": "resistance",
      "kind": "model",
      "changes": [
        "R",
        "derived_values"
      ],
      "fixed": [
        "supply_mode",
        "source_setpoint"
      ],
      "feedback": "拖动改变R，电流电压功率按约束更新"
    },
    {
      "id": "mode",
      "kind": "compare",
      "changes": [
        "supply_mode",
        "source_setpoint",
        "derived_values"
      ],
      "fixed": [
        "R",
        "scales"
      ],
      "feedback": "保持同一R，切换固定电压或固定电流；基准随控制条件重算"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "mode",
        "resistance"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "voltage",
    "target": "current",
    "action": "mode",
    "fixed": [
      "R",
      "scales"
    ],
    "placement": "图下供电方式单按钮切换"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "本例无时间播放；图内操作改变参数或观察位置，不附加播放功能。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
