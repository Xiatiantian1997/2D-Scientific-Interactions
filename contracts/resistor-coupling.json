{
  "version": "3.0",
  "goal": "同一个电阻变化在恒压与恒流下产生相反的发热趋势。",
  "model": {
    "assumptions": "理想欧姆电阻和无限顺应电源，温度不反馈到R；恒压6V或恒流2A；R=1.5至12Ω；I=U/R，P=UI，固定基准R=3Ω。",
    "evidence": "欧姆定律I=U/R及焦耳定律P=UI。"
  },
  "states": [
    {
      "id": "voltage",
      "meaning": "voltage"
    },
    {
      "id": "current",
      "meaning": "current"
    }
  ],
  "encodings": [
    {
      "scope": "resistor-coupling",
      "channel": "mark",
      "token": "current",
      "role": "quantity",
      "meaning": "电流及电流条"
    },
    {
      "scope": "resistor-coupling",
      "channel": "mark",
      "token": "power",
      "role": "quantity",
      "meaning": "功率及功率条"
    },
    {
      "scope": "resistor-coupling",
      "channel": "mark",
      "token": "ghost",
      "role": "observer",
      "meaning": "当前供电模式下R=3Ω的基准"
    }
  ],
  "actions": [
    {
      "id": "resistance",
      "kind": "model",
      "changes": [
        "R",
        "derived_values"
      ],
      "fixed": [
        "supply_mode",
        "source_setpoint"
      ],
      "feedback": "拖动改变R，电流电压功率按约束更新"
    },
    {
      "id": "mode",
      "kind": "compare",
      "changes": [
        "supply_mode",
        "source_setpoint",
        "derived_values"
      ],
      "fixed": [
        "R",
        "scales"
      ],
      "feedback": "保持同一R，切换固定电压或固定电流；基准随控制条件重算"
    },
    {
      "id": "lower-blank-reset",
      "kind": "model",
      "changes": [
        "resistance"
      ],
      "fixed": [
        "supply_mode"
      ],
      "feedback": "下方操作区空白短按或根区域R键复位；恢复 R=3 Ω，供电方式保持不变。控件、滚动、拖动、长按、多指和取消均不触发；轻暗反馈。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "voltage",
    "target": "current",
    "action": "mode",
    "fixed": [
      "R",
      "scales"
    ],
    "placement": "图下操作区两个供电条件按钮"
  },
  "validation": "../docs/validation.md"
}
