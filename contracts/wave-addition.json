{
  "version": "3.0",
  "goal": "同频同幅同向的两个波在同一点代数相加；相位差改变合成幅度。",
  "model": {
    "assumptions": "y1=sin(kx), y2=sin(kx+phi), sum=y1+y2。固定时刻的空间快照；调相位不代表时间演进。",
    "evidence": "线性叠加 y=y1+y2 与三角恒等式；固定时刻的空间快照。"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "同相等幅"
    },
    {
      "id": "changed",
      "meaning": "第二列波相位改变"
    }
  ],
  "encodings": [
    {
      "scope": "wave-addition",
      "channel": "fill-or-stroke",
      "token": "series-1",
      "role": "identity",
      "meaning": "第一列波"
    },
    {
      "scope": "wave-addition",
      "channel": "opacity-or-dash",
      "token": "ghost",
      "role": "observer",
      "meaning": "下图原波基准虚线"
    },
    {
      "scope": "wave-addition",
      "channel": "stroke",
      "token": "series-2",
      "role": "identity",
      "meaning": "第二列波，虚线"
    },
    {
      "scope": "wave-addition",
      "channel": "stroke",
      "token": "series-3",
      "role": "identity",
      "meaning": "两列波的逐点和，实线"
    }
  ],
  "actions": [
    {
      "id": "adjust",
      "kind": "model",
      "changes": [
        "relative_phase"
      ],
      "fixed": [
        "frequency",
        "individual_amplitude",
        "wavelength",
        "observation_time"
      ],
      "feedback": "拖动第二列波改变相位；点击滑条上方相位读数恢复同相；原波虚线提供基准。"
    },
    {
      "id": "compare",
      "kind": "compare",
      "changes": [
        "relative_phase"
      ],
      "fixed": [
        "scale",
        "layout"
      ],
      "feedback": "下方整个操作区的空白、说明文字、读数均可短按复位，整片轻暗反馈；滑条、播放等独立控件除外。超过8px移动、500ms长按、多指、取消、页面滚动不复位。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "changed",
    "action": "compare",
    "fixed": [
      "scale",
      "layout"
    ],
    "placement": "图下整片操作区空白与读数；无需精确瞄准文字"
  },
  "validation": "../docs/validation.md"
}
