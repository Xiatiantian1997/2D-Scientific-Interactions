{
  "version": "3.0",
  "goal": "同频同幅同向的两个波在同一点代数相加；相位差改变合成幅度。",
  "model": {
    "assumptions": "y1=sin(kx), y2=sin(kx+phi), sum=y1+y2。固定时刻的空间快照；调相位不代表时间演进。",
    "evidence": "线性叠加 y=y1+y2 与三角恒等式；固定时刻的空间快照。"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "同相等幅"
    },
    {
      "id": "changed",
      "meaning": "第二列波相位改变"
    }
  ],
  "encodings": [
    {
      "scope": "wave-addition",
      "channel": "fill-or-stroke",
      "token": "series-1",
      "role": "identity",
      "meaning": "第一列波"
    },
    {
      "scope": "wave-addition",
      "channel": "opacity-or-dash",
      "token": "ghost",
      "role": "observer",
      "meaning": "下图原波基准虚线"
    },
    {
      "scope": "wave-addition",
      "channel": "stroke",
      "token": "series-2",
      "role": "identity",
      "meaning": "第二列波，虚线"
    },
    {
      "scope": "wave-addition",
      "channel": "stroke",
      "token": "series-3",
      "role": "identity",
      "meaning": "两列波的逐点和，实线"
    }
  ],
  "actions": [
    {
      "id": "adjust",
      "kind": "model",
      "changes": [
        "relative_phase"
      ],
      "fixed": [
        "frequency",
        "individual_amplitude",
        "wavelength",
        "observation_time"
      ],
      "feedback": "拖动第二列波或滑轮改变相位，中央点击下一主档；原波虚线提供固定基准。"
    },
    {
      "id": "compare",
      "kind": "compare",
      "changes": [
        "relative_phase"
      ],
      "fixed": [
        "scale",
        "layout"
      ],
      "feedback": "短按对应控件区域实际空白恢复默认值；文字、读数、拖动、滚动、取消和多指不触发。"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "phase"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "changed",
    "action": "compare",
    "fixed": [
      "scale",
      "layout"
    ],
    "placement": "原位固定基准；对应控件区域空白局部复位"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "本例无时间播放；图内操作改变参数或观察位置，不附加播放功能。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
