{
  "version": "3.0",
  "goal": "局部测量不能代表整片：移动探针只读取同一个固定厚度场。",
  "model": {
    "assumptions": "固定合成厚度场h=100+18exp(-((x-.42)^2+(y+.25)^2)/.08)+4(x²+y²)，x,y为晶圆半径归一化坐标。300mm圆片，非实测；调坐标不改变薄膜。",
    "evidence": "SEMI MF1618公开摘要关于空间测点与均匀性：https://store-us.semi.org/products/mf161800-semi-mf1618-practice-for-determination-of-uniformity-of-thin-films-on-silicon-wafers"
  },
  "states": [
    {
      "id": "baseline",
      "meaning": "中心基准位置"
    },
    {
      "id": "adjusted",
      "meaning": "移动后的观察位置或参数组合"
    }
  ],
  "encodings": [
    {
      "scope": "wafer-probe",
      "channel": "visual-token",
      "token": "series-1",
      "role": "quantity",
      "meaning": "厚度，单色深浅对应100–122nm"
    },
    {
      "scope": "wafer-probe",
      "channel": "visual-token",
      "token": "probe-ring",
      "role": "observer",
      "meaning": "当前测点，非材料缺陷"
    }
  ],
  "actions": [
    {
      "id": "move",
      "kind": "inspect",
      "changes": [
        "probe_position"
      ],
      "fixed": [
        "thickness_field",
        "color_scale"
      ],
      "feedback": "拖动图中探针或参数点，关联读数更新；下方滑条支持单轴和键盘操作。"
    },
    {
      "id": "reset",
      "kind": "compare",
      "changes": [
        "probe_position"
      ],
      "fixed": [
        "thickness_field",
        "color_scale"
      ],
      "feedback": "下方整片空白短按回到中心，轻暗反馈。控件、滚动、多指、取消不触发。R键等价复位。"
    }
  ],
  "comparison": {
    "required": true,
    "baseline": "baseline",
    "target": "adjusted",
    "action": "reset",
    "fixed": [
      "thickness_field",
      "color_scale"
    ],
    "placement": "原位置观察，中心基准与整片操作区复位"
  },
  "validation": "../docs/validation.md"
}
