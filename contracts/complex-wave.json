{
  "version": "3.0",
  "goal": "从同一个复数箭头的两个投影理解实部与虚部，并看到余弦与正弦的来源。",
  "model": {
    "assumptions": "固定空间位置，模长归一化为1；相位θ为教学可控量，非真实空间转动或指定物理时间。a=cosθ,b=sinθ。",
    "evidence": "复数平面表示z=a+ib及欧拉公式exp(iθ)=cosθ+i sinθ；代数恒等式。"
  },
  "states": [
    {
      "id": "initial",
      "meaning": "45度，两个分量相等"
    },
    {
      "id": "scrub",
      "meaning": "直接改变相位，统一更新两投影与曲线上对应点"
    },
    {
      "id": "play",
      "meaning": "相位递增至360度后停止"
    },
    {
      "id": "paused",
      "meaning": "保持当前相位"
    }
  ],
  "encodings": [
    {
      "scope": "complex",
      "channel": "line",
      "token": "foreground",
      "role": "quantity",
      "meaning": "完整复数箭头"
    },
    {
      "scope": "complex",
      "channel": "line",
      "token": "series1",
      "role": "quantity",
      "meaning": "实部分量及余弦曲线"
    },
    {
      "scope": "complex",
      "channel": "line",
      "token": "series2",
      "role": "quantity",
      "meaning": "虚部分量及正弦曲线"
    },
    {
      "scope": "complex",
      "channel": "line",
      "token": "neutral-dash",
      "role": "observer",
      "meaning": "投影或选定相位辅助线"
    }
  ],
  "actions": [
    {
      "id": "phase",
      "kind": "construct",
      "changes": [
        "phase",
        "real",
        "imaginary"
      ],
      "fixed": [
        "magnitude",
        "space_position"
      ],
      "feedback": "拖动复数箭头或滑条，同步改变投影和曲线取样位置"
    },
    {
      "id": "play",
      "kind": "construct",
      "changes": [
        "phase",
        "real",
        "imaginary"
      ],
      "fixed": [
        "magnitude",
        "space_position"
      ],
      "feedback": "播放相位变化，到360度停止，可随时暂停和拖动"
    },
    {
      "id": "lower-blank-reset",
      "kind": "observe",
      "changes": [
        "phase"
      ],
      "fixed": [
        "amplitude"
      ],
      "feedback": "下方操作区空白短按或根区域R键复位；相位恢复45°。控件、滚动、拖动、长按、多指和取消均不触发；轻暗反馈。"
    }
  ],
  "comparison": {
    "required": false,
    "reason": "本单元展示同一对象同时存在的两个分量；坐标轴与完整单位圆为固定参考，无正常/异常或基准工况。"
  },
  "validation": "../docs/validation.md"
}
