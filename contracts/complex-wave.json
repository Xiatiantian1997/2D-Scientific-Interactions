{
  "version": "3.0",
  "goal": "从同一个复数箭头的两个投影理解实部与虚部，并看到余弦与正弦的来源。",
  "model": {
    "assumptions": "固定空间位置，模长归一化为1；相位θ为教学可控量，非真实空间转动或指定物理时间。a=cosθ,b=sinθ。",
    "evidence": "复数平面表示z=a+ib及欧拉公式exp(iθ)=cosθ+i sinθ；代数恒等式。"
  },
  "states": [
    {
      "id": "initial",
      "meaning": "45度，两个分量相等"
    },
    {
      "id": "scrub",
      "meaning": "直接改变相位，统一更新两投影与曲线上对应点"
    },
    {
      "id": "play",
      "meaning": "相位递增至360度后停止"
    },
    {
      "id": "paused",
      "meaning": "保持当前相位"
    }
  ],
  "encodings": [
    {
      "scope": "complex",
      "channel": "line",
      "token": "foreground",
      "role": "quantity",
      "meaning": "完整复数箭头"
    },
    {
      "scope": "complex",
      "channel": "line",
      "token": "series1",
      "role": "quantity",
      "meaning": "实部分量及余弦曲线"
    },
    {
      "scope": "complex",
      "channel": "line",
      "token": "series2",
      "role": "quantity",
      "meaning": "虚部分量及正弦曲线"
    },
    {
      "scope": "complex",
      "channel": "line",
      "token": "neutral-dash",
      "role": "observer",
      "meaning": "投影或选定相位辅助线"
    }
  ],
  "actions": [
    {
      "id": "phase",
      "kind": "construct",
      "changes": [
        "phase",
        "real",
        "imaginary"
      ],
      "fixed": [
        "magnitude",
        "space_position"
      ],
      "feedback": "拖动复数箭头或滑条，同步改变投影和曲线取样位置"
    },
    {
      "id": "play",
      "kind": "construct",
      "changes": [
        "phase",
        "real",
        "imaginary"
      ],
      "fixed": [
        "magnitude",
        "space_position"
      ],
      "feedback": "点击图形或对应进度控件播放/暂停；到终点回起点停住，保留其他参数。"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "phase"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": false,
    "reason": "本单元展示同一对象同时存在的两个分量；坐标轴与完整单位圆为固定参考，无正常/异常或基准工况。"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "默认静止；点击时间条或图形播放/暂停；结束回起点停住；失焦或后台暂停。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
