{
  "version": "3.0",
  "goal": "同一位置对应势能图的斜率、力与实际直线运动，曲线不是轨道。",
  "model": {
    "assumptions": "一维理想谐振子，弹性系数1N/m、质量1kg、无阻尼；U=x²/2，F=−x，拖动为外部放置并清零速度；释放后精确x=Acos(t),v=−Asin(t)，演示一个周期。",
    "evidence": "经典保守力 F=−dU/dx 与一维理想谐振子解析解；模型条件在页面注明。"
  },
  "states": [
    {
      "id": "placed",
      "meaning": "placed"
    },
    {
      "id": "running",
      "meaning": "running"
    },
    {
      "id": "paused",
      "meaning": "paused"
    }
  ],
  "encodings": [
    {
      "scope": "potential-force",
      "channel": "mark",
      "token": "object",
      "role": "identity",
      "meaning": "同一物体及其势能图取样点"
    },
    {
      "scope": "potential-force",
      "channel": "mark",
      "token": "force",
      "role": "quantity",
      "meaning": "势能切线及对应的力"
    },
    {
      "scope": "potential-force",
      "channel": "mark",
      "token": "guide",
      "role": "observer",
      "meaning": "两个表示的相同x位置对齐线"
    }
  ],
  "actions": [
    {
      "id": "place",
      "kind": "model",
      "changes": [
        "position",
        "velocity",
        "energy"
      ],
      "fixed": [
        "stiffness",
        "mass"
      ],
      "feedback": "拖动在外部放置物体，速度重置为零，位置同时更新两种表示"
    },
    {
      "id": "release",
      "kind": "time",
      "changes": [
        "time",
        "position",
        "velocity"
      ],
      "fixed": [
        "total_energy",
        "stiffness",
        "mass"
      ],
      "feedback": "点击图形或对应进度控件播放/暂停；到终点回起点停住，保留其他参数。"
    },
    {
      "id": "pause",
      "kind": "time",
      "changes": [
        "running"
      ],
      "fixed": [
        "position",
        "velocity",
        "energy"
      ],
      "feedback": "暂停保持当前状态，继续从当前时刻恢复"
    },
    {
      "id": "local-reset",
      "kind": "observe",
      "scopes": [
        "position",
        "time"
      ],
      "changes": [
        "selected scope default only"
      ],
      "fixed": [
        "other scopes",
        "recorded baseline"
      ],
      "feedback": "短按选定控件区域空白，或在该区域按 Escape。"
    }
  ],
  "comparison": {
    "required": false,
    "reason": "同一位置的势能、力和直线运动同时联动；不是正常/异常状态比较。"
  },
  "validation": "../docs/validation.md",
  "interaction": {
    "sop": "../docs/touch-and-controls.md",
    "host": "../runtime/touch-controls.js",
    "reset": "仅控件区域空白短按，按 controls.key 恢复声明的默认值，保留相邻状态和基准；Escape 是对应作用域的键盘替代。",
    "playback": "默认静止；点击时间条或图形播放/暂停；结束回起点停住；失焦或后台暂停。",
    "layout": "图上控件下，同类成组，普通按钮统一尺寸且居中，滑轮稍大。"
  }
}
