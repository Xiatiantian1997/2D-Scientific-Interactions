{
  "version": "3.0",
  "goal": "同一位置对应势能图的斜率、力与实际直线运动，曲线不是轨道。",
  "model": {
    "assumptions": "一维理想谐振子，弹性系数1N/m、质量1kg、无阻尼；U=x²/2，F=−x，拖动为外部放置并清零速度；释放后精确x=Acos(t),v=−Asin(t)，演示一个周期。",
    "evidence": "欧姆定律与焦耳定律；或经典保守力F=−dU/dx与谐振子解析解。模型条件在页面注明。"
  },
  "states": [
    {
      "id": "placed",
      "meaning": "placed"
    },
    {
      "id": "running",
      "meaning": "running"
    },
    {
      "id": "paused",
      "meaning": "paused"
    }
  ],
  "encodings": [
    {
      "scope": "potential-force",
      "channel": "mark",
      "token": "object",
      "role": "identity",
      "meaning": "同一物体及其势能图取样点"
    },
    {
      "scope": "potential-force",
      "channel": "mark",
      "token": "force",
      "role": "quantity",
      "meaning": "势能切线及对应的力"
    },
    {
      "scope": "potential-force",
      "channel": "mark",
      "token": "guide",
      "role": "observer",
      "meaning": "两个表示的相同x位置对齐线"
    }
  ],
  "actions": [
    {
      "id": "place",
      "kind": "model",
      "changes": [
        "position",
        "velocity",
        "energy"
      ],
      "fixed": [
        "stiffness",
        "mass"
      ],
      "feedback": "拖动在外部放置物体，速度重置为零，位置同时更新两种表示"
    },
    {
      "id": "release",
      "kind": "time",
      "changes": [
        "time",
        "position",
        "velocity"
      ],
      "fixed": [
        "total_energy",
        "stiffness",
        "mass"
      ],
      "feedback": "释放后沿直线做谐振动，一个周期后停止，可中断"
    },
    {
      "id": "pause",
      "kind": "time",
      "changes": [
        "running"
      ],
      "fixed": [
        "position",
        "velocity",
        "energy"
      ],
      "feedback": "暂停保持当前状态，继续从当前时刻恢复"
    },
    {
      "id": "lower-blank-reset",
      "kind": "observe",
      "changes": [
        "position_and_velocity"
      ],
      "fixed": [
        "mass_and_stiffness"
      ],
      "feedback": "下方操作区空白短按或根区域R键复位；恢复x=2 m、v=0。控件、滚动、拖动、长按、多指和取消均不触发；轻暗反馈。"
    }
  ],
  "comparison": {
    "required": false,
    "reason": "同一位置的势能、力和直线运动同时联动；不是正常/异常状态比较。"
  },
